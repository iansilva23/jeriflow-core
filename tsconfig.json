{
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "esModuleInterop": true
  },
  "include": [
    "apps/api/src/**/*.ts",
    "packages/contracts/src/**/*.ts"
  ]
}
